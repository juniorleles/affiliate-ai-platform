{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "campaignVerdict",
  "type": "object",
  "required": ["verdict", "confidence", "suggested_budget_change_pct", "reasoning"],
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["increase_budget", "maintain", "decrease_budget", "pause"]
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "cpa": { "type": ["number", "null"] },
    "roas": { "type": ["number", "null"] },
    "suggested_budget_change_pct": { "type": "number" },
    "reasoning": { "type": "string", "maxLength": 1200 }
  }
}
