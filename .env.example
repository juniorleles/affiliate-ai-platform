# --- Postgres ---
POSTGRES_USER=affiliate_platform
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=affiliate_platform
DATABASE_URL=postgresql://affiliate_platform:troque-esta-senha@localhost:5432/affiliate_platform

# --- Redis (fila) ---
REDIS_URL=redis://localhost:6379

# --- n8n ---
N8N_USER=admin
N8N_PASSWORD=troque-esta-senha

# --- API ---
PORT=3000
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
ADMIN_KEY=troque-esta-chave-admin
BASE_URL=http://localhost:3000

# Regra de comissão padrão do módulo affiliate-ops
DEFAULT_COMMISSION_TYPE=percentage
DEFAULT_COMMISSION_VALUE=10

# --- Google Ads API ---
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- IA ---
# Provider padrão usado pelo ai-advisor quando a tarefa não especifica outro (ver
# apps/api/src/shared/ai-provider). Assumido "claude" por padrão — troque se preferir.
DEFAULT_AI_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Liga a sincronização + análise automática agendada dentro da própria API
# (fallback simples caso o n8n ainda não esteja configurado)
ENABLE_INTERNAL_SCHEDULER=false

# --- Redes de afiliados (Módulo Discovery — preencher quando a Fase 2 começar) ---
DIGISTORE24_API_KEY=
CLICKBANK_API_KEY=
CJ_API_KEY=
IMPACT_API_KEY=
AWIN_API_KEY=
PARTNERSTACK_API_KEY=

# --- Inteligência competitiva (Módulo 3 — ver docs/ARQUITETURA.md seção 9, decisão em aberto) ---
COMPETITIVE_INTEL_PROVIDER=
COMPETITIVE_INTEL_API_KEY=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:3000
