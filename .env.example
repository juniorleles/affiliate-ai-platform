# --- Postgres ---
# ATENÇÃO: a senha aparece em dois lugares (POSTGRES_PASSWORD e dentro de
# DATABASE_URL) — se trocar uma, troque a outra também, senão a API conecta
# com uma credencial e o container sobe com outra.
POSTGRES_USER=affiliate_platform
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=affiliate_platform
DATABASE_URL=postgresql://affiliate_platform:troque-esta-senha@localhost:5432/affiliate_platform

# --- Redis (fila) ---
REDIS_URL=redis://localhost:6379

# --- n8n ---
N8N_USER=admin
N8N_PASSWORD=troque-esta-senha

# --- API ---
PORT=3000
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
ADMIN_KEY=troque-esta-chave-admin
BASE_URL=http://localhost:3000

# Regra de comissão padrão do módulo affiliate-ops
DEFAULT_COMMISSION_TYPE=percentage
DEFAULT_COMMISSION_VALUE=10

# --- Google Ads API ---
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Fase 6: cadastro de campanhas ---
# Trava dura de orçamento diário — nenhuma campanha pode ser criada acima
# disso, mesmo que a Economics sugira mais. Decisão registrada em
# docs/ARQUITETURA.md seção 10, item 9 (você escolheu a faixa R$ 50-100/dia;
# 100 é o teto usado aqui).
MAX_DAILY_BUDGET_HARD_CAP=100

# --- IA ---
# Provider padrão usado pelo ai-advisor quando a tarefa não especifica outro (ver
# apps/api/src/shared/ai-provider). Assumido "claude" por padrão — troque se preferir.
DEFAULT_AI_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Scheduler interno automático (fallback simples caso o n8n ainda não esteja
# configurado) — desacoplado em 2 flags (2026-08-05):
#
# MONITORING: leitura + comparação, ZERO custo de IA. Seguro ligar sem medo.
ENABLE_INTERNAL_SCHEDULER_MONITORING=false
#
# ANALYSIS: sync + análise de campanha por IA, a cada 24h, PRA SEMPRE enquanto
# ligado. Custo real e recorrente — NENHUM teto de gasto de IA implementado
# ainda (diferente do orçamento de campanha, que tem MAX_DAILY_BUDGET_HARD_CAP).
# Recomendação: ligue MONITORING primeiro, meça o consumo de IA real na sua
# conta Anthropic por uns dias, só então considere ligar isto.
ENABLE_INTERNAL_SCHEDULER_ANALYSIS=false

# --- Câmbio (shared/fx.js) ---
# Taxa de conversão de EUR para a moeda da SUA CONTA do Google Ads (nao e
# cotacao ao vivo -- atualize manualmente quando for relevante). Descubra a
# moeda da sua conta em Configuracoes > Preferencias de faturamento no Google
# Ads, ou via GET /api/campaigns/account-currency depois que o servidor subir.
# Exemplo: se a conta estiver em BRL e o cambio EUR/BRL for ~6.10, use 6.10.
FX_EUR_TO_ACCOUNT_CURRENCY=

# --- Performance real (Fase 3d, Camada A) ---
# PageSpeed Insights API — oficial, gratuita. Opcional: funciona sem chave em
# volume baixo (cota compartilhada). Pra cota maior, gere uma chave no Google
# Cloud Console (mesmo projeto onde criamos o OAuth Client do Google Ads) —
# não é a mesma chave do Google Ads.
GOOGLE_PAGESPEED_API_KEY=

# --- Análise visual (Fase 3d, Camada B) ---
# ScreenshotOne — conta grátis em screenshotone.com, 100 capturas/mês sem cartão.
# Decisão registrada em docs/ARQUITETURA.md seção 10, item 7.
SCREENSHOTONE_ACCESS_KEY=


# --- Redes de afiliados ---
# Descoberta automática via API foi REMOVIDA do escopo do projeto (2026-08-04) —
# cadastro é manual, via POST /api/products/manual ou /manual/bulk. Nenhuma
# credencial de rede de afiliados é necessária pra isso. Bloco removido.

# --- Inteligência competitiva (Módulo 3 — ver docs/ARQUITETURA.md seção 9, decisão em aberto) ---
COMPETITIVE_INTEL_PROVIDER=
COMPETITIVE_INTEL_API_KEY=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:3000
